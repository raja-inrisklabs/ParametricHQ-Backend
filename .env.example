# ==============================================================================
# PARAMETRIC DATA PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_NAME="Parametric Data Platform"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8080
API_PREFIX="/api/v1"
BASE_URL="http://localhost:8080"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# ------------------------------------------------------------------------------
# Storage Configuration (Scalable local layout -> GCS compatible)
# ------------------------------------------------------------------------------
# The API stores datasets, catalog.json, and jobs.json in this bucket.
# Objects use provider/{dataset}/{year}/{month}/{data_key}.parquet.
STORAGE_BACKEND="gcs"
STORAGE_DIR="./storage"
GCS_BUCKET_NAME="parametric_hq"
GOOGLE_CLOUD_PROJECT="testing-41686"

# ------------------------------------------------------------------------------
# Provider: ERA5 & ERA5-Land (ECMWF Copernicus Climate Data Store)
# ------------------------------------------------------------------------------
# Get your API key / personal access token from Copernicus Climate Data Store:
# https://cds.climate.copernicus.eu/
# If CDSAPI_KEY is empty, the platform operates in high-fidelity simulation mode
# so you can fetch, inspect, and analyze all variables immediately.
CDSAPI_URL="https://cds.climate.copernicus.eu/api"
CDSAPI_KEY=""
ERA5_FALLBACK_SIMULATION=true
